{{/* The product hero (name, badges, description, Access CTA) now renders from
     the shared doc layout, so the header card is gone. The spec viewer sits in a
     centered max-width container (like the MCP docs) instead of running
     full-bleed edge-to-edge. */}}
<div class="container docs-container mt-4">
  <div>

    <div id="asyncapi"></div>

    <script>
      AsyncApiStandalone.render({
        schema: {
          url: '{{.Url}}',
          options: { method: "GET", mode: "cors" },
        },
        config: {
          "show": {
            "sidebar": true,
            "info": true,
            "operations": true,
            "servers": true,
            "messages": true,
            "schemas": true,
            "errors": true
          },
          "expand": {
            "messageExamples": false
          },
          "sidebar": {
            "showServers": "byDefault",
            "showOperations": "byDefault"
          }
        },
      }, document.getElementById('asyncapi'));
    </script>

  </div>
</div>
