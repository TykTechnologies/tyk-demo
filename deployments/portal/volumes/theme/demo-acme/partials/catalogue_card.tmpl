{{/* Catalogue Product Card Partial
     Expects: Product object from GetProducts range
     Usage: {{ render "catalogue_card" . }}
*/}}
{{ $productName := .Name }}
{{ if .DisplayName }}
  {{ $productName = .DisplayName }}
{{ end }}
{{ $productPath := .Path }}
{{ $productLogo := .Logo.URL }}
{{ $productPreview := .Preview.URL }}
{{ $hasImage := or $productPreview $productLogo }}
{{ $hasDocs := false }}
{{ $hasAPIs := false }}

{{/* Determine if product has APIs/specs and documentation */}}
{{ if .IsDocumentationOnly}}
    {{ range .SpecDetails }}
        {{ $hasAPIs = true }}
        {{ $oasfile := gt (.OASDocument.Base.Url | trim | length) 0 }}
        {{ $oasurl := gt (.OASUrl | trim | length) 0 }}
        {{ $isGraphQL := eq .DocumentationType "graphqlSDL" }}
        {{ $isMCP := and (eq (printf "%s" .DocumentationType) "mcp") (gt (.MCPContent | trim | length) 0) }}
        {{ if or $oasfile $oasurl $isGraphQL $isMCP }}
          {{ $hasDocs = true }}
        {{end}}
    {{ end }}
{{else}}
  {{ range .APIDetails }}
    {{ $hasAPIs = true }}
    {{ $oasfile := gt (.OASDocument.Base.Url | trim | length) 0 }}
    {{ $oasurl := gt (.OASUrl | trim | length) 0 }}
    {{ $isGraphQL := or (eq .APIType "GraphQL") (eq .APIType "UDG") }}
    {{ $isMCP := and (eq .APIType "MCP") (gt (.MCPContent | trim | length) 0) }}
    {{ if or $oasfile $oasurl $isGraphQL $isMCP }}
      {{ $hasDocs = true }}
    {{end}}
  {{ end }}
{{end}}

<div class="col-lg-4 col-md-6 col-sm-12 card-container mb-4">
  <div class="card d-flex flex-column product-card {{ if $hasImage }}has-image{{ end }}" data-productname="{{ $productName }}">
    {{/* Card image section — the band is always rendered so every card has the
         same footprint as the Figma design; the placeholder background shows
         when the product has no image. */}}
    <div class="card-img-wrapper">
      {{ if $productPreview }}
        <img class="card-img-top card-image-border-card-view" src='{{$productPreview}}' alt="{{$productName}}">
      {{ else if $productLogo }}
        <img class="card-img-top card-image-border-card-view" src='{{$productLogo}}' alt="{{$productName}}">
      {{ else }}
        <img class="card-img-placeholder" src="/assets/images/card-placeholder.svg" alt="" aria-hidden="true">
      {{ end }}
    </div>

    {{/* Card body - contains badges + title + description */}}
    <div class="card-body">
      {{/* Badges - only show if product has APIs/specs */}}
      {{ if $hasAPIs }}
      <div class="card-badges">
        <div class="card-badges__api-types">
          {{/* Show API type badges */}}
          {{ if .IsDocumentationOnly }}
            {{ $hasGraphQL := false }}
            {{ $hasREST := false }}
            {{ $hasMCP := false }}
            {{ range .SpecDetails }}
              {{ if eq (printf "%s" .DocumentationType) "graphqlSDL" }}
                {{ $hasGraphQL = true }}
              {{ else if eq (printf "%s" .DocumentationType) "mcp" }}
                {{ $hasMCP = true }}
              {{ else }}
                {{ $hasREST = true }}
              {{ end }}
            {{ end }}
            {{ if $hasREST }}
              <span class="badge badge-api-type badge-rest">REST</span>
            {{ end }}
            {{ if $hasGraphQL }}
              <span class="badge badge-api-type badge-graphql">GraphQL</span>
            {{ end }}
            {{ if $hasMCP }}
              <span class="badge badge-api-type badge-mcp">MCP</span>
            {{ end }}
          {{ else }}
            {{/* Collect distinct API-type labels, then render badges in a
                 stable (alphabetical) order — APIDetails iteration order is
                 non-deterministic, so an unsorted range flickers the badges. */}}
            {{ $types := list }}
            {{ range .APIDetails }}
              {{ $formattedType := .GetAPITypeFormatted }}
              {{ if $formattedType }}
                {{ $types = append $types $formattedType }}
              {{ end }}
            {{ end }}
            {{ range ($types | uniq | sortAlpha) }}
              <span class="badge badge-api-type badge-{{ lower . }}">{{ . }}</span>
            {{ end }}
          {{ end }}
        </div>
        {{ if not .IsDocumentationOnly }}
        <div class="card-badges__auth-type">
          {{/* data-auth-type carries the raw AuthType key (authToken, jwt, ba,
               custom, multiAuth, mutualTLS) so the pill colour matches the
               portal-admin API-selector badges. */}}
          <span class="pill" data-auth-type="{{ .AuthType }}">{{ .GetAuthTypeBadgeFormatted }}</span>
        </div>
        {{ end }}
      </div>
      {{ end }}

      <div class="card-title d-flex flex-column mt-2 mb-0">
        <h2 class="heading-medium text-default mb-1">{{ $productName }}</h2>
      </div>
      {{if .Description }}
        <div class="card-text text-regular-14 mt-0">{{ safe .Description }}</div>
      {{end}}
    </div>

    {{/* Card footer with actions */}}
    <div class="card-cta d-flex flex-row w-100 justify-content-between align-items-center">
      {{if $hasDocs}}
        <div class="dropdown mb-0">
          <button class="btn btn-primary-outline dropdown-toggle" type="button" id="dropdownMenuButton-{{ $productPath }}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Docs
          </button>
          <div class="view-docs-dropdown dropdown-menu" aria-labelledby="dropdownMenuButton-{{ $productPath }}">
            {{ if .IsDocumentationOnly}}
              {{ range .SpecDetails }}
                {{ $oasfile := gt (.OASDocument.Base.Url | trim | length) 0 }}
                {{ $oasurl := gt (.OASUrl | trim | length) 0 }}
                {{ $isGraphQL := or (gt (.GraphQLServerEndpoint | trim | length) 0) (gt (.GraphQLSDL.Base.Url | trim | length) 0)}}
                {{ $isMCP := and (eq (printf "%s" .DocumentationType) "mcp") (gt (.MCPContent | trim | length) 0) }}
                {{ if or $oasfile $oasurl $isGraphQL $isMCP }}
                  <a href="/portal/catalogue-products/{{$productPath}}/{{.SpecAlias}}/docs" target="_blank">
                    <p class="docs-link">
                      {{ .SpecAlias }}
                      {{ if $isGraphQL }}
                        <span class="badge badge-api-type badge-graphql">GraphQL</span>
                      {{ else if $isMCP }}
                        <span class="badge badge-api-type badge-mcp">MCP</span>
                      {{ else }}
                        <span class="badge badge-api-type badge-rest">REST</span>
                      {{ end }}
                    </p>
                  </a>
                {{ end }}
              {{ end }}
            {{else}}
              {{ range .APIDetails }}
                {{ $oasfile := gt (.OASDocument.Base.Url | trim | length) 0 }}
                {{ $oasurl := gt (.OASUrl | trim | length) 0 }}
                {{ $isGraphQL := .IsGraphQLAPI }}
                {{ $isMCP := and .IsMCPAPI (gt (.MCPContent | trim | length) 0) }}
                {{ if or $oasfile $oasurl $isGraphQL $isMCP }}
                  <a href="/portal/catalogue-products/{{$productPath}}/{{.APIID}}/docs" target="_blank">
                    <p class="docs-link">
                      {{ .Name }}
                      {{ $formattedType := .GetAPITypeFormatted }}
                      <span class="badge badge-api-type badge-{{ lower $formattedType }}">{{ $formattedType }}</span>
                    </p>
                  </a>
                {{ end }}
              {{ end }}
            {{ end }}
          </div>
        </div>
      {{ else }}
        <div></div>
      {{ end }}
      <a href="/portal/catalogue-products/{{ $productPath }}" class="btn btn-primary learn-more-cta mb-0 mr-0">More info</a>
    </div>
  </div>
</div>
